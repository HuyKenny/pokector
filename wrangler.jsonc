/**
 * Pokector — Cloudflare Workers configuration.
 *
 * Environments: top-level = local dev defaults; env.staging / env.production are
 * separate Workers. NOTE (verified against current docs): bindings and `vars` are
 * NOT inherited by named environments — they must be fully re-declared per env.
 * `triggers` and `routes` ARE inherited, so staging explicitly overrides crons to [].
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pokector",
  "compatibility_date": "2026-07-16",
  "main": "./workers/app.ts",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
  },
  // Local dev triggers (staging/production override below). Test locally via:
  // curl "http://localhost:8787/cdn-cgi/handler/scheduled?cron=*/5+*+*+*+*"
  "triggers": {
    "crons": ["*/5 * * * *", "17 5 * * *"],
  },
  "vars": {
    "APP_NAME": "Pokector",
    "APP_URL": "http://localhost:5173",
    "ENVIRONMENT": "development",
    "DEFAULT_CURRENCY": "USD",
    "DEFAULT_LOCALE": "en-US",
    // eBay Partner Network Campaign ID (public — appears in every affiliate link)
    "EBAY_CAMPAIGN_ID": "5339136550",
    // Official Cloudflare Turnstile visible always-pass TEST sitekey (public)
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    // Local dev / E2E only: skip the browser Turnstile gate so automated flows
    // don't depend on the external challenge widget. NOT set in staging/production.
    "CAPTCHA_DISABLED": "true",
    "SUPPORT_EMAIL": "info@pokector.com",
    "LEGAL_OPERATOR_NAME": "Ha Duy Huy",
    "LEGAL_CONTACT_EMAIL": "info@pokector.com",
    "LEGAL_OPERATOR_ADDRESS": "Bartáková 36, 140 00 Praha, Czech Republic",
    "LEGAL_OPERATOR_ID": "IČO 07876823",
    // Stripe recurring Price IDs (public, per-env: TEST in dev/staging, LIVE in
    // production). Replace the placeholders with the IDs from your Stripe products.
    // The secret key + webhook secret are Worker SECRETS (see docs/SECRETS.md).
    "STRIPE_PRICE_MONTHLY": "price_test_replace_me_monthly",
    "STRIPE_PRICE_YEARLY": "price_test_replace_me_yearly",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pokector-staging",
      "database_id": "f897188b-f8a4-43be-a78f-7a8adf7a9614",
      "migrations_dir": "./drizzle/migrations",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "44d6009a011b435db357b0984f6c7ec3",
    },
  ],
  "queues": {
    "producers": [{ "binding": "JOBS_QUEUE", "queue": "pokector-jobs-staging" }],
    "consumers": [
      {
        "queue": "pokector-jobs-staging",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
      },
    ],
  },
  "env": {
    "staging": {
      "name": "pokector-staging",
      // crons are inherited by default — staging runs none (manual admin triggers)
      "triggers": {
        "crons": [],
      },
      "workers_dev": true,
      "vars": {
        "APP_NAME": "Pokector",
        // updated to the real workers.dev URL after first deploy
        "APP_URL": "https://pokector-staging.huy-kenny.workers.dev",
        "ENVIRONMENT": "staging",
        "DEFAULT_CURRENCY": "USD",
        "DEFAULT_LOCALE": "en-US",
        "EBAY_CAMPAIGN_ID": "5339136550",
        // staging uses the Turnstile TEST sitekey (always pass) until a real
        // staging widget is provisioned in Phase 10
        "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
        "SUPPORT_EMAIL": "info@pokector.com",
        "LEGAL_OPERATOR_NAME": "Ha Duy Huy",
        "LEGAL_CONTACT_EMAIL": "info@pokector.com",
        "LEGAL_OPERATOR_ADDRESS": "Bartáková 36, 140 00 Praha, Czech Republic",
        "LEGAL_OPERATOR_ID": "IČO 07876823",
        // Stripe TEST-mode recurring Price IDs for staging.
        "STRIPE_PRICE_MONTHLY": "price_test_replace_me_monthly",
        "STRIPE_PRICE_YEARLY": "price_test_replace_me_yearly",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "pokector-staging",
          "database_id": "f897188b-f8a4-43be-a78f-7a8adf7a9614",
          "migrations_dir": "./drizzle/migrations",
        },
      ],
      "kv_namespaces": [
        {
          "binding": "KV",
          "id": "44d6009a011b435db357b0984f6c7ec3",
        },
      ],
      "queues": {
        "producers": [{ "binding": "JOBS_QUEUE", "queue": "pokector-jobs-staging" }],
        "consumers": [
          {
            "queue": "pokector-jobs-staging",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 3,
          },
        ],
      },
    },
    "production": {
      "name": "pokector-production",
      "workers_dev": true,
      "triggers": {
        "crons": ["*/5 * * * *", "17 5 * * *"],
      },
      // Custom domains (parking DNS replaced 2026-07-17). Both apex and www hit
      // the worker; www→apex 301 is handled in workers/app.ts (canonicalRedirect).
      "routes": [
        { "pattern": "pokector.com", "custom_domain": true },
        { "pattern": "www.pokector.com", "custom_domain": true },
      ],
      "vars": {
        "APP_NAME": "Pokector",
        "APP_URL": "https://pokector.com",
        "ENVIRONMENT": "production",
        "DEFAULT_CURRENCY": "USD",
        "DEFAULT_LOCALE": "en-US",
        "EBAY_CAMPAIGN_ID": "5339136550",
        // replaced with the real production widget sitekey in Phase 10
        "TURNSTILE_SITE_KEY": "0x4AAAAAAD33n0rHJcspIYG9",
        "SUPPORT_EMAIL": "info@pokector.com",
        "LEGAL_OPERATOR_NAME": "Ha Duy Huy",
        "LEGAL_CONTACT_EMAIL": "info@pokector.com",
        "LEGAL_OPERATOR_ADDRESS": "Bartáková 36, 140 00 Praha, Czech Republic",
        "LEGAL_OPERATOR_ID": "IČO 07876823",
        // Stripe LIVE-mode recurring Price IDs for production.
        "STRIPE_PRICE_MONTHLY": "price_1TvMMnE0DjqLJAGXsWOKIhLL",
        "STRIPE_PRICE_YEARLY": "price_1TvMLjE0DjqLJAGXtBy8e3JB",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "pokector-production",
          "database_id": "de00baa4-de9b-42f7-8428-75f998d313a0",
          "migrations_dir": "./drizzle/migrations",
        },
      ],
      "kv_namespaces": [
        {
          "binding": "KV",
          "id": "44314bee2a4740aaabd6e009846f3aed",
        },
      ],
      "queues": {
        "producers": [{ "binding": "JOBS_QUEUE", "queue": "pokector-jobs-production" }],
        "consumers": [
          {
            "queue": "pokector-jobs-production",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 3,
          },
        ],
      },
    },
  },
}
