# Node-side tooling variables (drizzle-kit remote migrations, scripts).
# Copy to .env if needed. Never commit .env.
# Non-secret app configuration lives in wrangler.jsonc `vars`.

# Cloudflare account (needed only for drizzle-kit d1-http driver, if used):
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_DATABASE_ID=""
CLOUDFLARE_D1_TOKEN=""
