{
  "name": "pokector",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "typecheck": "wrangler types && react-router typegen && tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply pokector-staging --local",
    "db:migrate:staging": "wrangler d1 migrations apply pokector-staging --env staging --remote",
    "db:migrate:production": "wrangler d1 migrations apply pokector-production --env production --remote",
    "admin:grant": "node scripts/admin-grant.mjs",
    "deploy:staging": "CLOUDFLARE_ENV=staging react-router build && wrangler deploy",
    "deploy:production": "CLOUDFLARE_ENV=production react-router build && wrangler deploy",
    "deploy:dry-run": "CLOUDFLARE_ENV=production react-router build && wrangler deploy --dry-run",
    "preview": "pnpm run build && vite preview",
    "cf-typegen": "wrangler types",
    "postinstall": "wrangler types",
    "synth:data": "node scripts/synth-data.mjs",
    "perf:test": "node scripts/perf-test.mjs",
    "smoke": "node scripts/smoke-live.mjs"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.27",
    "better-auth": "^1.7.27",
    "chart.js": "^4.6.1",
    "drizzle-orm": "^0.45.4",
    "isbot": "^5.2.3",
    "react": "^19.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.1",
    "react-router": "8.5.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/vite-plugin": "^1.70.1",
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@eslint/js": "^10.0.1",
    "@mdx-js/rollup": "^3.1.1",
    "@playwright/test": "^1.65.1",
    "@react-router/dev": "8.5.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.20.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "atmn": "^1.1.23",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.10.1",
    "puppeteer-core": "^24.43.1",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx-frontmatter": "^5.2.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^4.1.10",
    "wrangler": "^4.166.0"
  }
}
