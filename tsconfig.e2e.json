{
  "extends": "./tsconfig.json",
  "include": ["test/e2e/**/*", "playwright.config.ts"],
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["node"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "paths": { "~/*": ["./app/*"] },
    "esModuleInterop": true,
    "resolveJsonModule": true
  }
}
